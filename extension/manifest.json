{
  "manifest_version": 3,
  "name": "La Bonne Pioche — lecteur Leboncoin",
  "version": "0.6.1",
  "description": "Ouvre les recherches Leboncoin demandées par l'outil La Bonne Pioche dans ton navigateur et lui renvoie les annonces affichées.",
  "key": "",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": { "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" } },
  "permissions": ["tabs", "scripting"],
  "host_permissions": ["https://www.leboncoin.fr/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "externally_connectable": {
    "matches": ["https://*.workers.dev/*", "http://localhost/*", "http://127.0.0.1/*"]
  }
}
