{
  // Cloudflare Worker: API (/api/*) + the built web app (static assets).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "affaires",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "not_found_handling": "single-page-application", "run_worker_first": ["/api/*"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "affaires",
      // Replace with the id printed by `npx wrangler d1 create affaires` (README).
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  // LLM_PROVIDER: "openai" (default) or "claude".
  "vars": { "LLM_PROVIDER": "openai", "OPENAI_MODEL": "gpt-5.5", "CLAUDE_MODEL": "claude-opus-5-5" }
  // Secrets (never in this file): OPENAI_API_KEY or ANTHROPIC_API_KEY, APP_PASSWORD, SESSION_SECRET.
}
